---
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="Digital Library">
  <main>
    <Header />
    <div class="exp">
      <a-scene xr-mode-ui="enabled: false">
        <a-assets>
          <img id="skyTexture" src="/pano/360.jpg" alt="sky" />
        </a-assets>
        <a-sky src="#skyTexture"></a-sky>

        <a-entity id="stacks" camera look-controls>
          <a-camera look-controls wasd-controls="enabled: false"></a-camera>
          <a-entity id="range-01">
            <a-plane
              clickhandler="txt: range1"
              class="stack"
              color="#fff"
              opacity="0"
              width="4"
              height="1.5"
              rotation="0 80 0"
              position="-1.2 2 -0.7"></a-plane>
            <a-text
              value="Range 01"
              width="6"
              scale="2 2 2"
              opacity="0.7"
              position="-2.5 0.25 -1.5"
              rotation="0 90 0"></a-text>
          </a-entity>
        </a-entity>
        <a-entity cursor="rayOrigin:mouse" raycaster="objects: .stack, a-text"
        ></a-entity>
      </a-scene>
    </div>
  </main>
</Layout>

<script is:inline>
  if (!AFRAME?.components["clickhandler"]) {
    AFRAME?.registerComponent("clickhandler", {
      schema: {
        txt: { default: "default" },
      },
      init: function () {
        this.plusIndicator = document.createElement("a-text");
        this.plusIndicator.setAttribute("value", "+");
        this.plusIndicator.setAttribute("position", "0 0.2 0");
        this.plusIndicator.setAttribute("scale", "1.5 1.5 1.5");
        this.plusIndicator.setAttribute("opacity", "0"); // Initially hidden
        this.plusIndicator.setAttribute("color", "#ffff00");

        this.el.appendChild(this.plusIndicator);

        this.el.addEventListener("mouseenter", this.onMouseEnter.bind(this));
        this.el.addEventListener("mouseleave", this.onMouseLeave.bind(this));
        this.el.addEventListener("click", this.onClick.bind(this));
      },
      onMouseEnter: function () {
        this.plusIndicator.setAttribute("opacity", "1"); // Show on hover
      },
      onMouseLeave: function () {
        this.plusIndicator.setAttribute("opacity", "0"); // Hide when not hovering
      },
      onClick: function () {
        console.log(this.data.txt);
        window.location.href = "/range/1";
      },
    });
  }
</script>

<style>
  main {
    margin: auto;
    width: 100svw;
    color: white;
    line-height: 1.6;
  }

  footer {
    display: flex;
    padding: 1rem;
    position: absolute;
    bottom: 1rem;
  }

  .exp {
    position: absolute;
    inset: 0;
    width: 100svw;
    height: 100svh;
    /* z-index: -1; */

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
