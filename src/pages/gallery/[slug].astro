---
import type { InferGetStaticParamsType } from "astro";
import Layout from "@layouts/Layout.astro";
import { fetchArtworks } from "@data/api";
import type { Artwork } from "@/types";

export async function getStaticPaths() {
  const artworks = await fetchArtworks();
  return artworks?.map((artwork: Artwork) => ({
    params: { slug: artwork.slug },
    props: { artwork },
  }));
}

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
const { slug } = Astro.params as Params;
const { artwork } = Astro.props as { artwork: Artwork };
const pdfUrl = artwork?.files[0].url;
---

<Layout title="Digital Library">
  <main>
    <header>
      <div class="left">
        <a href="/" class="btn btn-black">OFFICE00</a>
      </div>

      <div class="center">
        <h1>{artwork?.title}</h1>
      </div>

      <div class="right">
        <button class="btn btn-black" id="hypothesis">Annotate</button>
      </div>
    </header>
    <div class="pdf">
      <div id="viewerContainer" data-pdf={pdfUrl}></div>
    </div>
  </main>
</Layout>

<script src="@ts/annotate.ts"></script>
<!-- <script src="@ts/pdfViewerSetup.ts"></script> -->

<style>
  body {
    overflow: hidden;
  }
  #viewerContainer {
    position: absolute;
    width: 100%;
    overflow: auto;
  }

  .pdfViewer {
    width: 100%;
  }

  button {
    cursor: pointer;
  }

  header {
    display: flex;
    justify-content: space-between;
    padding: 1rem;
    align-items: center;
  }
</style>
