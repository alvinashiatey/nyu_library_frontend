---
import type { InferGetStaticParamsType } from "astro";
import Layout from "@layouts/Layout.astro";
import { fetchBooks } from "@data/api";
import type { Book } from "@/types";
import PDFViewer from "@components/react/PDFViewer";

export async function getStaticPaths() {
  const books = await fetchBooks();
  return books?.map((book: Book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
const { slug } = Astro.params as Params;
const { book } = Astro.props as { book: Book };
const pdfUrl = book?.files[1].url;
---

<Layout title="Digital Library">
  <main>
    <header>
      <div class="left">
        <a href="/" class="btn btn-black">OFFICE00</a>
      </div>

      <div class="center">
        <h1>{book?.title}</h1>
      </div>

      <div class="right">
        <button class="btn btn-black" id="hypothesis">Annotate</button>
      </div>
    </header>
    <div class="pdf">
      <div id="viewerContainer" data-pdf={pdfUrl}>
        <PDFViewer file={pdfUrl} client:only="react" />
      </div>
    </div>
  </main>
</Layout>

<script src="@ts/annotate.ts"></script>
<!-- <script src="@ts/pdfViewerSetup.ts"></script> -->

<style>
  body {
    overflow: hidden;
  }
  #viewerContainer {
    position: absolute;
    width: 100%;
    overflow: auto;
  }

  .pdfViewer {
    width: 100%;
  }

  header {
    display: flex;
    justify-content: space-between;
    padding: 1rem;
    align-items: center;
  }
</style>
