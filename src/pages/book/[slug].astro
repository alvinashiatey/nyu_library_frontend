---
import type { InferGetStaticParamsType } from "astro";
import Layout from "@layouts/Layout.astro";
import { fetchBooks } from "@data/api";
import type { Book } from "@/types";
import PDFViewerApp from "@/pages/viewer";

export async function getStaticPaths() {
  const books = await fetchBooks();
  return books?.map((book: Book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
const { slug } = Astro.params as Params;
const { book } = Astro.props as { book: Book };
const pdfUrl = book?.files[1].url;
const workerPath = "//unpkg.com/pdfjs-dist/build/pdf.worker.min.mjs";
---

<Layout title="Digital Library">
  <main>
    <header>
      <div class="left">
        <a href="/" class="btn btn-black">OFFICE00</a>
      </div>

      <div class="center">
        <h1>{book?.title}</h1>
      </div>

      <div class="right">
        <button id="hypothesis">Annotate</button>
      </div>
    </header>
    <div class="pdf">
      <PDFViewerApp client:load pdfFilePath={pdfUrl} />
      <h1>PDF Viewer</h1>
      <div id="viewerContainer" data-pdf={pdfUrl} data-worker={workerPath}>
        <div id="pdfViewer" class="pdfViewer"></div>
      </div>
    </div>
  </main>
</Layout>

<script type="module" src="@ts/annotate.ts"></script>
<!-- <script src="@ts/pdfViewerSetup.ts"></script> -->

<style>
  #viewerContainer {
    position: absolute;
    width: 100%;
    height: 100vh;
    overflow: auto;
    background: #ccc;
  }

  .pdfViewer {
    width: 100%;
  }
</style>
