---
import Layout from "@layouts/Layout.astro";
import StackView from "@components/StackView.astro";
import { fetchBooks } from "@data/api";
import type { Book } from "@/types";

export async function getStaticPaths() {
  const books = await fetchBooks();

  const booksByStack = books.reduce<Record<string, Book[]>>((acc, book) => {
    (acc[book.stack] ??= []).push(book);
    return acc;
  }, {});

  return Object.entries(booksByStack).map(([stack, books]) => ({
    params: { slug: stack },
    props: { books, stack },
  }));
}

const { books, stack } = Astro.props as { books: Book[]; stack: string };
---

<Layout title={`Stack ${stack} - Digital Library`}>
  <main>
    <StackView books={books} stack={stack} isRange=true />
  </main>
</Layout>

<style>
  main {
    margin: auto;
    width: 100svw;
    color: white;
    line-height: 1.6;
  }

  footer {
    display: flex;
    padding: 1rem;
    position: absolute;
    bottom: 1rem;
  }
</style>
