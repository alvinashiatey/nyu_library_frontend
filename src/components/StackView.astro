---
import type { Book } from "@/types";
import BookCard from "./BookCard.astro";
const { books, stack, isRange } = Astro.props as { books: Book[]; stack?: string, isRange?: boolean };
const paddedStack = Number(stack) < 10 ? `0${stack}` : stack;
const background = `url(/public/range/r${paddedStack}.png)`;
---

<div class="books">
  <div class="container">
    <div class="preview">
      <div class="image" style={{ backgroundImage: background }}></div>
    </div>
    <div class="content">
      <header>
        <div class="range">
          <h2>
            Range <span class="text-white-50">{paddedStack}</span>
          </h2>
        </div>
        <div class="back">
          <a href="/" class="btn-svg">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          </a>
        </div>
      </header>
      <div class="books">
        {books.map((book) => <BookCard book={book} isRange={isRange} />)}
      </div>
    </div>
  </div>
</div>

<style>
  .container {
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    color: black;
  }

  .preview {
    width: 70%;
    background-color: #181818;
  }

  .preview .image {
    width: 100%;
    height: 100%;
    background-repeat: no-repeat;
    background-size: cover;
  }

  header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    padding: 1rem;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 30%;
  }

  .books {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: black;
    overflow: scroll;
  }
.btn-svg {
    width: 100%;
    height: 100%;

    svg {
      border-radius: 0.5rem;
      background-color: black;
      width: 2rem;
      height: 2rem;
      fill: none;
      stroke: beige;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }
</style>
