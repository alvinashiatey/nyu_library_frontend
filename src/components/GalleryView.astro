---
import type { Artwork } from "@/types";
import ArtworkCard from "./ArtworkCard.astro";
const { artwork } = Astro.props as {
  artwork: Artwork;
};
---

<div class="gallery">
  <div class="container">
    <div class="preview">
      <ArtworkCard artwork={artwork} thumbnailMode={false} />
    </div>
    <div class="content">
      <header>
        <div class="range">
          <h2>Gallery</h2>
        </div>
        <div class="back">
          <a href="/gallery" class="btn btn-black"> x </a>
        </div>
      </header>
      <div class="artwork-info">
        <h2>{artwork.title}</h2>
        <p>{artwork.description}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .container {
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    color: black;
  }

  .preview {
    width: 70%;
    background-color: #181818;
  }

  .preview .image {
    width: 100%;
    height: 100%;
    background-repeat: no-repeat;
    background-size: cover;
  }

  header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    padding: 1rem;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 30%;
  }

  .artwork-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: black;
    overflow: auto;
    padding: 1rem;
  }
</style>
