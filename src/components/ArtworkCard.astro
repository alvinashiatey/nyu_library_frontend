---
import type { Artwork as ArtworkType } from "@/types";
import Artwork from "@/components/Artwork.astro";

export interface Props {
  artwork: ArtworkType;
  thumbnailMode?: boolean;
}

const { artwork, thumbnailMode = true } = Astro.props;
---

{
  thumbnailMode ? (
    <a href={`/gallery/${artwork.slug}`}>
      <Artwork artwork={artwork} thumbnailMode={thumbnailMode} />
    </a>
  ) : (
    <Artwork artwork={artwork} thumbnailMode={thumbnailMode} />
  )
}

<style>
  a {
    text-decoration: none;
    color: inherit;
  }
</style>
