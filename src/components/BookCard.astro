---
import type { Book } from "@/types";
import { Image } from "astro:assets";
const { book, isRange } = Astro.props as { book: Book , isRange?: boolean };
---
<a href={`/book/${book.slug}`}>
<div class={`book ${isRange ? "range" : ""}`}>
        <div class="image">
                {
                        book.files.map((file)=>(
                                file.type === "image" ? <Image src={file.url} alt={book.title} width=100 height=100 /> : null
                        ))
                }
        </div>

        <div class="info">
                <h3>{book.title}</h3>
                <p class="desc">
                        {book.description}
                </p>
        </div>
</div>
</a>

<style>
        a {
                        text-decoration: none;
                        color: inherit;
                }

    .book {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
                &.range {
                        flex-direction: row;
                        .image, .info {
                                flex: 1;
                        }
                }
        
        .image {
          aspect-ratio: 1/1;
          width: 100%;
          overflow: hidden;
          background-color: #bebebe;
          outline: 1px solid #bebebe30;
          
          img{
                  width: 100%;
                  height: 100%;
                  object-fit: cover;
                  transition: transform 0.3s cubic-bezier(0.445, 0.05, 0.55, 0.95);
          }

        }
        
        .info {
              
                        h3 {
                              font-weight: bold;
                          margin-bottom: 0.5rem;
                        }
        }

        .desc{
                display: -webkit-box;
                -webkit-box-orient: vertical;
                -webkit-line-clamp: 4;
                line-clamp: 4;
                overflow: hidden;
        }
            
    }
        .book:hover {
        background-color: #f0f0f0;
      }

</style>
